# 複製為 .env 後再填入；.env 已被 .gitignore 排除，請勿提交或傳送金鑰。
# 安全預設：disabled 不會發出任何模型或網路請求。
# 本機 Ollama：EMOSIM_MODEL_PROVIDER=ollama
# Gemini 雲端（可能產生用量）：EMOSIM_MODEL_PROVIDER=gemini
EMOSIM_MODEL_PROVIDER=disabled

# 從 Google AI Studio 建立。不要把實際金鑰填進 .env.example。
GEMINI_API_KEY=

# 官方目前列為穩定且可用於免費層的預設文字模型；可在 AI Studio 更換。
EMOSIM_GEMINI_MODEL=gemini-3.8-flash

# 只有選用 Ollama 時需要；名稱依你本機已下載的模型調整。
EMOSIM_OLLAMA_MODEL=qwen3:latest
EMOSIM_OLLAMA_BASE_URL=http://127.0.0.1:11434
